# Example .env file - copy to .env and fill the values

# WebSocket / Socket.IO endpoint (wss://...)
DATA_WS_URL=
# Session token used for auth (if required by the WS)
WS_AUTH_TOKEN=
# Optional: if the WS requires an Origin header, set it here (e.g. https://pocketoption.com)
WS_ORIGIN=
# Optional: if the WS requires a cookie, set it here (e.g. session=...)
WS_COOKIE=

# Telegram bot token and chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional config
MIN_CONFIDENCE=0.6
